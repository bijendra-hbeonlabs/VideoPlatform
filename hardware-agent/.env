# Hardware Device Identity (leave blank to auto-detect from MAC + Hostname)
VDP_DEVICE_ID=

# Web Server & MQTT Broker Credentials
VDP_MQTT_BROKER=66.116.227.217
VDP_MQTT_PORT=1883
VDP_MQTT_USER=admin
VDP_MQTT_PASS=admin123

VDP_SERVER_IP=66.116.227.217
VDP_SERVER_PORT=5000

# MariaDB / MySQL Configuration
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASS=root
MARIADB_DB=videodisplaydb

# Local Ports & Directories
VDP_LOCAL_PORT=8765
VDP_MEDIA_DIR=media/videos
