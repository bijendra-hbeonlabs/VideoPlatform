@page "/playlists"
@using VideoDisplayPlatform.Application.Services
@using VideoDisplayPlatform.Domain.Entities.Media
@using VideoDisplayPlatform.Domain.Entities.Playback
@inject DevicePlatformStateService StateService
@implements IDisposable

<PageTitle>Media & Playlists - Video Display Platform</PageTitle>

<div class="top-bar">
    <div class="page-header">
        <h1>Media & Playlist Manager</h1>
        <p>Manage video assets, sequence playback loops, and configure duration parameters</p>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="OpenAddPlaylistModal">+ Create Playlist Loop</button>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Playlists Overview -->
    <div class="table-container">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color);">
            <h3 style="font-size: 1.1rem; font-weight: 600;">Active Playlists</h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Playlist Name</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pl in PlaylistList)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 600; color: white;">@pl.PlaylistName</div>
                            <div style="font-size: 0.75rem; color: var(--text-dim);">@pl.Description</div>
                        </td>
                        <td>
                            <span class="badge badge-online">Active</span>
                        </td>
                        <td>
                            <span style="color: var(--text-muted);">@pl.CreatedAtUtc.ToLocalTime().ToString("d")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Video Media Assets -->
    <div class="table-container">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 600;">Video Media Library</h3>
            <span style="font-size: 0.85rem; color: var(--accent-cyan); font-weight: 600;">H.264 / HEVC / 4K</span>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Video Title</th>
                    <th>Resolution</th>
                    <th>Codec</th>
                    <th>Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vid in Videos)
                {
                    <tr>
                        <td>
                            <div style="font-weight: 600; color: white;">@vid.VideoName</div>
                            <div class="code-font" style="font-size: 0.75rem; color: var(--text-dim);">@vid.VideoCode</div>
                        </td>
                        <td>
                            <span class="code-font" style="font-size: 0.85rem;">@vid.Width x @vid.Height</span>
                        </td>
                        <td>
                            <span class="code-font" style="font-size: 0.8rem; color: var(--primary);">@(vid.Codec ?? "H.264")</span>
                        </td>
                        <td>
                            <span class="code-font" style="color: var(--accent-teal);">@((vid.DurationMs ?? 0) / 1000)s</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ADD PLAYLIST MODAL -->
@if (IsAddModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: white;">Create New Playlist Loop</h3>
                <button style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;" @onclick="CloseAddPlaylistModal">×</button>
            </div>
            
            <div class="form-group">
                <label class="form-label">Playlist Name *</label>
                <input type="text" class="form-input" @bind="NewName" placeholder="e.g. Morning Commercial Loop 4K" />
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea class="form-textarea" @bind="NewDescription" placeholder="Description or target display notes..." rows="2"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Loop Count (0 = Infinite)</label>
                <input type="number" class="form-input" @bind="NewLoopCount" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
                <button class="btn btn-secondary" @onclick="CloseAddPlaylistModal">Cancel</button>
                <button class="btn btn-primary" @onclick="HandleCreatePlaylist">✓ Save Playlist</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Playlist> PlaylistList = new();
    private List<Video> Videos = new();
    private bool IsAddModalOpen = false;
    private string NewName = string.Empty;
    private string NewDescription = string.Empty;
    private int NewLoopCount = 0;

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += HandleStateChanged;
        RefreshData();
    }

    private void RefreshData()
    {
        PlaylistList = StateService.GetAllPlaylists();
        Videos = StateService.GetAllVideos();
    }

    private void OpenAddPlaylistModal()
    {
        NewName = string.Empty;
        NewDescription = string.Empty;
        NewLoopCount = 0;
        IsAddModalOpen = true;
    }

    private void CloseAddPlaylistModal() => IsAddModalOpen = false;

    private void HandleCreatePlaylist()
    {
        if (!string.IsNullOrWhiteSpace(NewName))
        {
            StateService.CreatePlaylist(NewName, NewDescription, NewLoopCount);
            IsAddModalOpen = false;
            RefreshData();
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() =>
        {
            RefreshData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= HandleStateChanged;
    }
}
