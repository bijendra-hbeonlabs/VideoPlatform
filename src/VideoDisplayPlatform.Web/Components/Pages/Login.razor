@page "/login"
@using VideoDisplayPlatform.Application.Services
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Login - Video Display Platform</PageTitle>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center;
     background: var(--bg-primary); background-image:
     radial-gradient(circle at 20% 30%, rgba(99,102,241,0.12) 0%, transparent 45%),
     radial-gradient(circle at 80% 75%, rgba(16,185,129,0.08) 0%, transparent 45%);">

    <div style="width:100%; max-width:420px; padding:0 1.5rem;">
        <!-- Logo -->
        <div style="text-align:center; margin-bottom:2.5rem;">
            <div style="width:64px; height:64px; background:linear-gradient(135deg,#6366f1,#06b6d4);
                 border-radius:16px; display:flex; align-items:center; justify-content:center;
                 font-size:1.8rem; font-weight:800; color:white; margin:0 auto 1rem; box-shadow:0 0 24px rgba(99,102,241,0.5);">
                VDP
            </div>
            <h1 style="font-size:1.6rem; font-weight:700; color:white; margin-bottom:0.3rem;">
                Video Display Platform
            </h1>
            <p style="color:var(--text-muted); font-size:0.9rem;">HBeonLabs Enterprise Edition v3.1</p>
        </div>

        <!-- Card -->
        <div style="background:rgba(18,24,36,0.85); backdrop-filter:blur(16px);
             border:1px solid rgba(255,255,255,0.1); border-radius:18px; padding:2.5rem;
             box-shadow:0 20px 60px rgba(0,0,0,0.5);">

            <h2 style="font-size:1.2rem; font-weight:600; margin-bottom:1.75rem; color:white;">
                Administrator Login
            </h2>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="background:rgba(244,63,94,0.15); border:1px solid rgba(244,63,94,0.4);
                     border-radius:8px; padding:0.85rem 1rem; margin-bottom:1.25rem;
                     color:#f87171; font-size:0.9rem; display:flex; align-items:center; gap:0.5rem;">
                    ⚠️ @ErrorMessage
                </div>
            }

            <div class="form-group">
                <label class="form-label">Username</label>
                <input id="login-username" type="text" class="form-input" placeholder="admin"
                       @bind="Username" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") HandleLogin(); })" />
            </div>

            <div class="form-group" style="margin-top:1.1rem;">
                <label class="form-label">Password</label>
                <input id="login-password" type="password" class="form-input" placeholder="••••••••"
                       @bind="Password" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") HandleLogin(); })" />
            </div>

            <button id="login-submit" class="btn btn-primary"
                    style="width:100%; justify-content:center; margin-top:1.75rem; padding:0.85rem;"
                    @onclick="HandleLogin" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span>Authenticating...</span>
                }
                else
                {
                    <span>🔐 Sign In to Dashboard</span>
                }
            </button>

            <div style="margin-top:1.5rem; text-align:center; color:var(--text-dim); font-size:0.8rem;">
                MQTT Broker: <strong style="color:var(--accent-cyan);">66.116.227.217:1883</strong>
            </div>
        </div>

        <div style="text-align:center; margin-top:1.5rem; color:var(--text-dim); font-size:0.78rem;">
            © 2026 HBeonLabs Systems. All rights reserved.
        </div>
    </div>
</div>

@code {
    private string Username = string.Empty;
    private string Password = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsLoading = false;

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
            Nav.NavigateTo("/");
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        StateHasChanged();

        await Task.Delay(400); // Brief auth animation

        if (AuthService.Login(Username, Password))
        {
            Nav.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Invalid username or password. Please try again.";
            IsLoading = false;
        }
    }
}
