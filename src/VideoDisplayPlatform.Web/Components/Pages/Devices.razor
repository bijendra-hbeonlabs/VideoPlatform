@page "/devices"
@using VideoDisplayPlatform.Application.Common.Interfaces
@using VideoDisplayPlatform.Application.Services
@using VideoDisplayPlatform.Domain.Entities.Core
@inject DevicePlatformStateService StateService
@inject IMqttService MqttService
@implements IDisposable

<PageTitle>Device Fleet - Video Display Platform</PageTitle>

<div class="top-bar">
    <div class="page-header">
        <h1>Device Fleet Management</h1>
        <p>Monitor, provision, and control registered display hardware nodes</p>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="OpenAddDeviceModal">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            + Register New Device
        </button>
    </div>
</div>

<!-- Search & Filter Header -->
<div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
    <input type="text" class="form-input" placeholder="🔍 Search device code, name, serial number..." @bind="SearchQuery" @bind:event="oninput" style="max-width: 380px;" />
    <select class="form-select" @bind="StatusFilter" style="max-width: 180px;">
        <option value="ALL">All Statuses</option>
        <option value="ONLINE">Online Only</option>
        <option value="OFFLINE">Offline / Warning</option>
    </select>
</div>

<!-- Device Grid / Table -->
<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Device Code / Name</th>
                <th>Hardware / OS</th>
                <th>Location</th>
                <th>Connectivity</th>
                <th>Telemetry (CPU/RAM/Temp)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dev in FilteredDevices)
            {
                var status = StateService.GetDeviceStatus(dev.DeviceId);
                var isOnline = status?.ConnectivityStatus == 1;

                <tr>
                    <td>
                        <div style="font-weight: 600; color: white;">@dev.DeviceName</div>
                        <div class="code-font" style="font-size: 0.8rem; color: var(--primary);">@dev.DeviceCode • @dev.SerialNumber</div>
                    </td>
                    <td>
                        <div style="font-weight: 500;">@dev.HardwareModel</div>
                        <div style="font-size: 0.75rem; color: var(--text-dim);">@dev.OsVersion</div>
                    </td>
                    <td>
                        <div>@(dev.Location?.BuildingName ?? "Main Terminal")</div>
                        <div style="font-size: 0.75rem; color: var(--text-dim);">@(dev.Location?.City ?? "Default Site"), @(dev.Location?.Country ?? "USA")</div>
                    </td>
                    <td>
                        @if (isOnline)
                        {
                            <span class="badge badge-online"><span class="status-dot"></span> Online</span>
                        }
                        else
                        {
                            <span class="badge badge-offline"><span class="status-dot"></span> Warning</span>
                        }
                    </td>
                    <td>
                        <div class="code-font" style="font-size: 0.85rem;">CPU: @(status?.CpuPercent ?? 0)% | RAM: @(status?.MemoryPercent ?? 0)%</div>
                        <div class="code-font" style="font-size: 0.8rem; color: var(--accent-cyan);">Temp: @(status?.TemperatureC ?? 0)°C | Storage: @(status?.StoragePercent ?? 0)%</div>
                    </td>
                    <td>
                        <div style="display: flex; gap: 0.4rem;">
                            <button class="btn btn-secondary btn-sm" @onclick="@(() => SendCommand(dev.DeviceId, "REBOOT"))">Reboot</button>
                            <button class="btn btn-secondary btn-sm" @onclick="@(() => SendCommand(dev.DeviceId, "SYNC_MEDIA"))">Sync</button>
                            <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteDevice(dev.DeviceId))">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ADD DEVICE MODAL FORM -->
@if (IsAddModalOpen)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <div class="modal-header">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: white;">Register New Display Device</h3>
                <button style="background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer;" @onclick="CloseAddDeviceModal">×</button>
            </div>
            
            <EditForm Model="NewDeviceDto" OnValidSubmit="HandleCreateDevice">
                <div class="form-group">
                    <label class="form-label">Device Display Name *</label>
                    <InputText class="form-input" @bind-Value="NewDeviceDto.DeviceName" placeholder="e.g. Airport Concourse 4K Display" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Device Code / Identifier</label>
                    <InputText class="form-input" @bind-Value="NewDeviceDto.DeviceCode" placeholder="e.g. DEV-NYC-005 (Auto-generated if blank)" />
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Hardware Model</label>
                        <InputText class="form-input" @bind-Value="NewDeviceDto.HardwareModel" placeholder="e.g. Raspberry Pi 5 / NVIDIA Jetson" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Serial Number</label>
                        <InputText class="form-input" @bind-Value="NewDeviceDto.SerialNumber" placeholder="e.g. SN-894120" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Building / Site Location</label>
                        <InputText class="form-input" @bind-Value="NewDeviceDto.BuildingLocation" placeholder="e.g. Terminal 2 Entrance" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">City</label>
                        <InputText class="form-input" @bind-Value="NewDeviceDto.City" placeholder="e.g. San Francisco" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description / Notes</label>
                    <InputTextArea class="form-textarea" @bind-Value="NewDeviceDto.Description" placeholder="Optional installation details or display resolution details..." rows="2" />
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddDeviceModal">Cancel</button>
                    <button type="submit" class="btn btn-primary">✓ Register Device</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Device> DeviceList = new();
    private string SearchQuery = string.Empty;
    private string StatusFilter = "ALL";
    private bool IsAddModalOpen = false;
    private CreateDeviceDto NewDeviceDto = new();

    protected override void OnInitialized()
    {
        StateService.OnStateChanged += HandleStateChanged;
        RefreshDevices();
    }

    private void RefreshDevices()
    {
        DeviceList = StateService.GetAllDevices();
    }

    private IEnumerable<Device> FilteredDevices => DeviceList.Where(d =>
        (string.IsNullOrWhiteSpace(SearchQuery) ||
         d.DeviceName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
         d.DeviceCode.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
         (d.SerialNumber != null && d.SerialNumber.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
        &&
        (StatusFilter == "ALL" ||
         (StatusFilter == "ONLINE" && StateService.GetDeviceStatus(d.DeviceId)?.ConnectivityStatus == 1) ||
         (StatusFilter == "OFFLINE" && StateService.GetDeviceStatus(d.DeviceId)?.ConnectivityStatus != 1))
    );

    private void OpenAddDeviceModal()
    {
        NewDeviceDto = new CreateDeviceDto();
        IsAddModalOpen = true;
    }

    private void CloseAddDeviceModal()
    {
        IsAddModalOpen = false;
    }

    private void HandleCreateDevice()
    {
        StateService.CreateDevice(NewDeviceDto);
        IsAddModalOpen = false;
        RefreshDevices();
    }

    private async Task SendCommand(long deviceId, string action)
    {
        await MqttService.PublishCommandAsync(deviceId, action, new { action });
    }

    private void DeleteDevice(long deviceId)
    {
        StateService.DeleteDevice(deviceId);
        RefreshDevices();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() =>
        {
            RefreshDevices();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        StateService.OnStateChanged -= HandleStateChanged;
    }
}
